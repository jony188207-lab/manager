rules_version = '2';

// All writes go through the Node.js backend (Firebase Admin SDK bypasses these rules and
// validates input with zod). The browser may only READ non-secret collections, and only when
// the signed-in user has an active record in /admins. Roles are read from Firestore, never
// from anything the client supplies.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function isActiveAdmin() {
      return signedIn() && exists(adminPath()) && get(adminPath()).data.active == true;
    }

    function isSuperAdmin() {
      return isActiveAdmin() && get(adminPath()).data.role == 'super_admin';
    }

    match /admins/{uid} {
      allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /bots/{id} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    match /groups/{id} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    match /channels/{id} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    match /verificationSettings/{id} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    match /buttons/{id} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    match /welcomeMessages/{id} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    match /verificationLogs/{id} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    match /settings/{id} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    // Encrypted bot tokens and in-flight join requests: backend only.
    match /botSecrets/{id} {
      allow read, write: if false;
    }

    match /pendingRequests/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

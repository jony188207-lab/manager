# Copy to backend/.env for local development. Never commit the real file.
# In production, set these as environment secrets on your host or secret manager.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Number of reverse proxies in front of the app (1 for most PaaS hosts)
TRUST_PROXY=1

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
# Option A (local): path to a service account key file, handled by Google libraries
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# Option B (hosts without files): the full service account JSON on a single line
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Public HTTPS URL of this backend, used to build Telegram webhook URLs
PUBLIC_BASE_URL=https://your-backend.example.com

# Comma-separated list of allowed frontend origins (Firebase Hosting domains)
CORS_ALLOWED_ORIGINS=http://localhost:5000,https://your-project.web.app

# 32 random bytes, base64. Encrypts bot tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_API=120
RATE_LIMIT_MAX_WEBHOOK=600
